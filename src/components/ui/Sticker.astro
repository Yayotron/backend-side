---
interface Props {
  label: string;
  variant?: 'poster' | 'project';
}

const { label, variant = 'poster' } = Astro.props;
---

<span class:list={['sticker', variant]}>{label}</span>

<style>
  .sticker {
    display: inline-block;
    width: fit-content;
    border: var(--border-current);
    padding: var(--space-2) var(--space-10);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    transform: rotate(var(--tilt-sticker));
  }

  .poster {
    position: absolute;
    top: var(--space-20);
    right: var(--space-20);
  }

  .project {
    border: var(--border-current-heavy);
    padding: var(--space-4) var(--space-14);
    font-size: var(--text-body);
    transform: rotate(var(--tilt-project));
  }
</style>
