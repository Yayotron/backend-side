---
import { getBudgetLayout } from '../../lib/budget';
import type { BudgetSegment } from '../../lib/budget';

interface Props {
  label: string;
  segments: readonly BudgetSegment[];
  unit?: string;
  caption?: string;
}

const { label, segments, unit = 'ms', caption = '' } = Astro.props;
const { blocks, description } = getBudgetLayout(segments, unit);
---

<figure>
  <div class="blocks" role="img" aria-label={`${label}. ${description}.`}>
    {blocks.map((block) => (
      <div
        class:list={['block', block.tone]}
        style={`--segment-share: ${block.percentage}%`}
        aria-hidden="true"
      >
        <span>{block.displayValue}</span>
      </div>
    ))}
  </div>
  <figcaption>
    <ul class="legend" aria-label="Budget steps">
      {blocks.map((block) => (
        <li
          style={`--segment-share: ${block.percentage}%`}
          title={`${block.label}: ${block.displayValue} ${unit}`}
        >
          {block.label}
        </li>
      ))}
    </ul>
    {caption && <p>{caption}</p>}
  </figcaption>
</figure>

<style>
  figure {
    margin: 0;
  }

  .blocks {
    display: flex;
    height: var(--space-84);
    max-width: 100%;
    margin: var(--space-18) 0 var(--space-8);
    border: var(--border);
    box-shadow: var(--shadow-idea);
  }

  .block {
    flex: 0 1 var(--segment-share);
    position: relative;
    min-width: 0;
    border-right: var(--border);
    background: var(--color-primary);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: normal;
    overflow: hidden;
  }

  .block span {
    position: absolute;
    bottom: var(--space-8);
    left: var(--space-8);
  }

  .accent {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .support {
    background: var(--color-support);
    color: var(--color-ink);
  }

  .legend {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-legend);
    font-weight: var(--weight-bold);
  }

  li {
    flex: 0 1 var(--segment-share);
    min-width: 0;
    padding-right: var(--space-4);
    white-space: nowrap;
    overflow: hidden;
  }

  p {
    margin: var(--space-8) 0 0;
    color: var(--color-mute);
    font-size: var(--text-sm);
  }
</style>
