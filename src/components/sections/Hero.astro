---
interface Props {
  nameLines: readonly [string, string];
  description: string;
  role: string;
  caption: string;
}

const { nameLines, description, role, caption } = Astro.props;
---

<section class="hero" aria-label="Introduction">
  <h1>
    {nameLines.map((line) => (
      <>
        <span>{line}</span>{' '}
      </>
    ))}
  </h1>
  <p>{description}</p>
  <div class="block">
    {role}
    <small>{caption}</small>
  </div>
</section>

<style>
  .hero {
    display: block;
    position: relative;
    padding-block: var(--space-34) var(--space-70);
    overflow: hidden;
  }

  h1 {
    position: relative;
    z-index: 1;
    margin-left: calc(-1 * var(--space-6));
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    overflow-wrap: anywhere;
  }

  h1 span {
    display: block;
  }

  p {
    position: relative;
    z-index: 1;
    max-width: var(--measure-hero);
    margin: var(--space-34) 0 0;
    font-size: var(--text-lede);
    font-weight: var(--weight-medium);
    line-height: var(--leading-lede);
  }

  .block {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: absolute;
    top: var(--space-20);
    right: var(--space-24);
    width: var(--hero-block-width);
    height: var(--hero-block-height);
    padding: var(--space-30) var(--space-34);
    border: var(--border);
    box-shadow: var(--shadow-hero);
    background: var(--color-primary);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-hero-block);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-block);
    line-height: var(--leading-block);
    overflow-wrap: anywhere;
  }

  small {
    margin-top: var(--space-14);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--weight-bold);
    letter-spacing: normal;
    line-height: normal;
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      padding-bottom: var(--space-40);
      overflow: visible;
    }

    h1 {
      margin-left: 0;
    }

    .block {
      position: static;
      width: auto;
      height: auto;
      min-height: var(--hero-block-min);
      margin: var(--space-28) var(--space-8) 0 0;
      padding: var(--space-26);
    }
  }
</style>
