---
import { getDiagramPaths } from '../../lib/diagram';
import type { DiagramEdge, DiagramNode } from '../../lib/diagram';

interface Props {
  id: string;
  title: string;
  description: string;
  nodes: readonly DiagramNode[];
  edges: readonly DiagramEdge[];
  variant?: 'panel' | 'poster';
}

const { id, title, description, nodes, edges, variant = 'panel' } = Astro.props;
const paths = getDiagramPaths(nodes, edges);
---

<figure class:list={['architecture', variant]}>
  <svg
    viewBox="0 0 640 300"
    role="img"
    aria-labelledby={`${id}-title`}
    aria-describedby={`${id}-description`}
  >
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-description`}>{description}</desc>
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path class="arrow" d="M0 0L10 5L0 10z" />
      </marker>
    </defs>
    {paths.map((edge) => (
      <path
        class="edge"
        d={edge.path}
        data-from={edge.from}
        data-to={edge.to}
        marker-end={`url(#${id}-arrow)`}
      />
    ))}
    {nodes.map((node) => (
      <g class:list={['node', { highlighted: node.highlight }]}>
        <rect
          data-node={node.id}
          x={node.x}
          y={node.y}
          width={node.width}
          height={node.height}
        />
        <text
          x={node.x + node.width / 2}
          y={node.y + node.height / 2}
          text-anchor="middle"
          dominant-baseline="central"
        >
          {node.label}
        </text>
      </g>
    ))}
  </svg>
  <figcaption>
    <ul aria-label="Diagram legend">
      <li>
        <span class="swatch highlight" aria-hidden="true"></span>Highlighted
      </li>
      <li>
        <span class="swatch" aria-hidden="true"></span>Other
      </li>
    </ul>
  </figcaption>
</figure>

<style>
  .architecture {
    --diagram-color: currentColor;
    --diagram-highlight: var(--color-accent);
    --diagram-highlight-text: var(--color-ink);

    margin: 0;
  }

  .poster {
    --diagram-highlight: currentColor;
    --diagram-highlight-text: var(--poster-background);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  rect,
  .edge {
    fill: none;
    stroke: var(--diagram-color);
    stroke-width: var(--diagram-stroke);
  }

  .arrow,
  text {
    fill: var(--diagram-color);
  }

  text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .highlighted rect {
    fill: var(--diagram-highlight);
  }

  .highlighted text {
    fill: var(--diagram-highlight-text);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-12);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-legend);
    font-weight: var(--weight-bold);
  }

  li {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }

  .swatch {
    flex-shrink: 0;
    width: var(--space-14);
    height: var(--space-14);
    border: var(--border-current);
  }

  .highlight {
    background: var(--diagram-highlight);
  }
</style>
